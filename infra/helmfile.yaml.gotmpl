releases:

  - name: traefik
    namespace: traefik
    chart: oci://ghcr.io/traefik/helm/traefik
    version: 39.0.2
    values:
      - values-traefik.yaml
    createNamespace: true

  - name: cert-manager
    namespace: cert-manager
    chart: jetstack/cert-manager
    version: v1.19.4
    values:
      - values-cert-manager.yaml
    createNamespace: true
    hooks:
      - events: ["postsync"]
        showlogs: true
        command: /bin/sh
        args:
          - -c
          - |
            kubectl apply -f - <<EOF
            apiVersion: cert-manager.io/v1
            kind: ClusterIssuer
            metadata:
              name: letsencrypt
            spec:
              acme:
                server: https://acme-v02.api.letsencrypt.org/directory
                email: luc.juggery@exoscale.ch
                privateKeySecretRef:
                  name: letsencrypt-key
                solvers:
                  - http01:
                      ingress:
                        class: traefik
            EOF

  - name: qrpods
    namespace: default
    labels:
      app: qrpods
    chart: ../chart
    needs:
    - traefik/traefik
    - cert-manager/cert-manager
    values:
      - values-qrpods.yaml
      - app:
          scanToken: {{ requiredEnv "SCAN_TOKEN" }}
          dashboardPassword: {{ requiredEnv "DASHBOARD_PASSWORD" }}
          secretKey: {{ requiredEnv "SECRET_KEY" }}
        registry:
          user: {{ requiredEnv "QRPOD_REGISTRY_USER" }}
          pass: {{ requiredEnv "QRPOD_REGISTRY_PASS" }}
          email: {{ requiredEnv "QRPOD_REGISTRY_EMAIL" }}
    createNamespace: true
