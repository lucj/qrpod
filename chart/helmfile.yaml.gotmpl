helmDefaults:
  wait: true
  timeout: 300
  recreatePods: false
  force: false

releases:
  - name: qr-pods
    namespace: default
    chart: .
    values:
      - values.yaml
      - registry:
          user: {{ requiredEnv "QRPOD_REGISTRY_USER" }}
          pass: {{ requiredEnv "QRPOD_REGISTRY_PASS" }}
          email: {{ requiredEnv "QRPOD_REGISTRY_EMAIL" }}
    createNamespace: true